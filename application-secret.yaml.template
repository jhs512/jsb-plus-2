# 이 파일을 application-secret.yaml 로 복사한 뒤 값을 채우세요. (application-secret.yaml은 .gitignore 대상)
# 값을 채우지 않은 항목은 지워 두세요. 빈 값이면 해당 기능이 오동작할 수 있습니다.
spring:
  mail: # 비밀번호 찾기 메일 발송 (없으면 로그로만 출력)
    host: smtp.gmail.com
    port: 587
    username: 보내는_메일_주소
    password: 앱_비밀번호
    properties:
      mail.smtp.auth: true
      mail.smtp.starttls.enable: true
  security:
    oauth2:
      client:
        registration: # 소셜 로그인 (없으면 소셜 로그인 버튼이 나오지 않음)
          google: # https://console.cloud.google.com -> API 및 서비스 -> 사용자 인증 정보
            # 승인된 리디렉션 URI: http://localhost:8080/login/oauth2/code/google
            client-id: 구글_클라이언트_ID
            client-secret: 구글_클라이언트_시크릿
            scope: openid, profile, email
